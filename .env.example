# Пример настроек. Файл хранится в репозитории и содержит только безопасные
# значения для локального запуска в Docker. docker compose читает сначала его,
# затем .env (если он есть), поэтому свои значения кладите в .env — он в .gitignore.

APP_ENV=local

# --- PostgreSQL ---
# Учётные данные PostgreSQL в контейнере db; с локально установленным PostgreSQL не связаны.
# После их изменения пересоздайте том: docker compose down -v
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_password
POSTGRES_DB=applications
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Аутентификация ---
# Ключ подписи JWT. Значение ниже годится только для локального запуска —
# в .env задайте свой длинный случайный ключ.
JWT_SECRET_KEY=local-dev-only-secret-replace-in-env-file
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Включите (true), когда приложение работает по HTTPS
REFRESH_COOKIE_SECURE=false

# --- Заявки ---
# Регион по умолчанию для номеров телефона, введённых без кода страны
PHONE_DEFAULT_REGION=TJ
# Каталог для документов при запуске без Docker (в Docker используется том /data/uploads)
UPLOAD_DIR=uploads

# --- Платёжный шлюз (заглушка) ---
# flaky — иногда отвечает с задержкой, иногда ошибкой.
# stable (всегда успешно) включает только сквозной тест в docker-compose.e2e.yml.
PAYMENT_GATEWAY=flaky
# доли исходов в каждой серии из 10 оплат: 30% отказов, 30% задержек, остальные 40% — успех
PAYMENT_FAILURE_RATE=0.3
PAYMENT_DELAY_RATE=0.3
# длительность задержки, секунды (случайно в этом диапазоне); фронтенд ждёт ответ 7 с,
# дальше показывает «Платёж обрабатывается…» и повторяет запрос с тем же ключом
PAYMENT_DELAY_MIN_SECONDS=5
PAYMENT_DELAY_MAX_SECONDS=12
# сколько backend ждёт шлюз, прежде чем признать попытку неудачной
PAYMENT_GATEWAY_TIMEOUT_SECONDS=15

# --- Фронтенд ---
# Адрес API, к которому обращается браузер. Подставляется при старте контейнера frontend.
FRONTEND_API_URL=http://localhost:8000/api

# --- CORS ---
# Фронтенд и backend — разные приложения на разных портах, поэтому браузеру нужно
# явно разрешить запросы. Через запятую: фронтенд в Docker и dev-сервер Vite.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
