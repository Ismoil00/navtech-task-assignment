# Пример настроек. Файл хранится в репозитории и содержит только безопасные
# значения для локального запуска в Docker. docker compose читает сначала его,
# затем .env (если он есть), поэтому свои значения кладите в .env — он в .gitignore.

APP_ENV=local

# --- PostgreSQL ---
# Учётные данные придуманы для контейнера db и существуют только внутри него.
# Это не учётные данные вашего локального PostgreSQL.
# После их изменения пересоздайте том: docker compose down -v
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_password
POSTGRES_DB=applications
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Аутентификация ---
# Ключ подписи JWT. Значение ниже годится только для локального запуска —
# в .env задайте свой длинный случайный ключ.
JWT_SECRET_KEY=local-dev-only-secret-change-me-in-your-own-env-file
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Включите (true), когда приложение работает по HTTPS
REFRESH_COOKIE_SECURE=false

# --- CORS ---
# Фронтенд и backend — разные приложения на разных портах, поэтому браузеру нужно
# явно разрешить запросы. Через запятую: фронтенд в Docker и dev-сервер Vite.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
